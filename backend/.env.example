# Copy to .env and edit. Everything has a safe default; the app runs with none of these set.
DATABASE_URL=sqlite:///./careerpilot.db
# Supabase / PostgreSQL example (install psycopg first: pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=5

# LLM: leave as mock to run with deterministic template agents (no key, no cost).
LLM_PROVIDER=mock
# LLM_PROVIDER=openai          # works with any OpenAI-compatible API
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1      # or https://api.groq.com/openai/v1
# LLM_MODEL=gpt-4o-mini
