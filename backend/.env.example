# Copy to .env and edit. Everything has a safe default; the app runs with none of these set.
# development (default) or production. Production hides the /docs pages and needs a real SECRET_KEY.
APP_ENV=development
DATABASE_URL=sqlite:///./careerpilot.db
# PostgreSQL (Render, Supabase, Neon): paste the URL the host gives you; postgres:// and postgresql:// both work.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# At least 32 random characters in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated website addresses allowed to call the API, e.g. https://careerpilot.vercel.app
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=5

# LLM: leave as mock to run with deterministic template agents (no key, no cost).
LLM_PROVIDER=mock
# LLM_PROVIDER=openai          # works with any OpenAI-compatible API
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1      # or https://api.groq.com/openai/v1
# LLM_MODEL=gpt-4o-mini

# Google Gemini (free key from https://aistudio.google.com/apikey):
# LLM_PROVIDER=openai
# LLM_API_KEY=your-gemini-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.6-flash

# Live job postings from Adzuna (free key: https://developer.adzuna.com). Leave blank to use sample jobs.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=au
# ADZUNA_RESULTS=30        # postings fetched per search (max 50)
# JOBS_CACHE_HOURS=12      # reuse saved results for this long before calling the API again

# Live learning resources for the study plan.
# Microsoft Learn Catalog API is free with no key (set false to turn off).
LEARNING_MSLEARN=true
# YouTube Data API v3 key (free, 100 searches/day): https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
# LEARNING_CACHE_DAYS=7    # reuse live results per skill for this many days

# Semantic matching with a neural embedding model (35% of each match score).
# "api" uses the LLM key and URL above by default (Gemini works as-is); "local" uses word overlap only.
EMBEDDING_PROVIDER=api
EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_API_KEY=       # only if different from LLM_API_KEY
# EMBEDDING_BASE_URL=      # only if different from LLM_BASE_URL

# Third-party resume parser for the 'How an ATS reads your CV' check on CV review.
# The first provider with a key is used. Recommended: APILayer, free plan with 100 parses a month and no card.
# Sign up at https://marketplace.apilayer.com/resume_parser-api , subscribe to the Free plan, copy your API key.
APILAYER_API_KEY=

# Alternative: Eden AI (paid credits).
# Eden AI: sign up at https://app.edenai.run/user/register,
# then Settings > My API Keys. The Affinda parser costs about US$0.07 per CV,
# and each CV is parsed once, only when you press the button.
EDENAI_API_KEY=
EDENAI_RESUME_MODEL=ocr/resume_parser/affinda

# Alternative: Textkernel Tx v10, used only if the keys above are blank.
# Free trial: 500 credits, 1 credit per CV (each CV is parsed once, only when you press the button).
# Sign up: https://cloud.textkernel.com/tx/console/register . Use the base URL of your account's data centre
# (AU: https://api.au.textkernel.com/tx/v10, US: https://api.us.textkernel.com/tx/v10, EU: https://api.eu.textkernel.com/tx/v10).
TEXTKERNEL_ACCOUNT_ID=
TEXTKERNEL_SERVICE_KEY=
TEXTKERNEL_BASE_URL=https://api.au.textkernel.com/tx/v10
