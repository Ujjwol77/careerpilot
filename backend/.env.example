# Copy to .env and edit. Everything has a safe default; the app runs with none of these set.
DATABASE_URL=sqlite:///./careerpilot.db
# Supabase / PostgreSQL example (install psycopg first: pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=5

# LLM: leave as mock to run with deterministic template agents (no key, no cost).
LLM_PROVIDER=mock
# LLM_PROVIDER=openai          # works with any OpenAI-compatible API
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1      # or https://api.groq.com/openai/v1
# LLM_MODEL=gpt-4o-mini

# Google Gemini (free key from https://aistudio.google.com/apikey):
# LLM_PROVIDER=openai
# LLM_API_KEY=your-gemini-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.6-flash

# Live job postings from Adzuna (free key: https://developer.adzuna.com). Leave blank to use sample jobs.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=au
# ADZUNA_RESULTS=30        # postings fetched per search (max 50)
# JOBS_CACHE_HOURS=12      # reuse saved results for this long before calling the API again
